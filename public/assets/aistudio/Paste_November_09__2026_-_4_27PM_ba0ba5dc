      document.getElementById("quoteCustomerSelect").value = quote.customerId || "";

      const pill = document.getElementById("quoteStatusPill");
      pill.textContent = quote.status || "DRAFT";
      pill.className = quote.status === "FINALIZED"
        ? "px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"
        : "px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30";

      const auditText = `Last edited by ${quote.lastEditedBy || 'Team'} at ${quote.lastEditedAt || 'just now'}`;
      document.getElementById("lastEditedByBanner").textContent = auditText;
      document.getElementById("liveAuditBox").innerHTML = `
        <div class="text-emerald-400 font-semibold">${quote.quoteNumber}</div>
        <div>By: <strong>${quote.lastEditedBy || 'Team'}</strong></div>
        <div class="text-[11px] text-slate-400">Time: ${quote.lastEditedAt || ''}</div>
      `;

      // Render Line Items
      const tbody = document.getElementById("quoteItemsTableBody");
      tbody.innerHTML = "";
      const items = quote.items || [];
      let subtotal = 0;
      let totalTax = 0;

      items.forEach((item, idx) => {
        const qty = Number(item.qty || 0);
        const rate = Number(item.rate || 0);
        const gst = Number(item.gst || 0);
        const rawLine = qty * rate;
        const taxLine = rawLine * (gst / 100);
        const lineTotal = rawLine + taxLine;
        subtotal += rawLine;
        totalTax += taxLine;

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="py-2 px-2">
            <input type="text" value="${item.name || ''}" oninput="updateQuoteLineItem(${idx}, 'name', this.value)" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs" />
          </td>
          <td class="py-2 px-2">
            <input type="number" value="${qty}" oninput="updateQuoteLineItem(${idx}, 'qty', Number(this.value||0))" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs" />
          </td>
          <td class="py-2 px-2">
            <input type="number" value="${rate}" oninput="updateQuoteLineItem(${idx}, 'rate', Number(this.value||0))" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs" />
          </td>
          <td class="py-2 px-2">
            <input type="number" value="${gst}" oninput="updateQuoteLineItem(${idx}, 'gst', Number(this.value||0))" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs" />
          </td>
          <td class="py-2 px-2 text-right font-bold text-slate-200">
            ₹${lineTotal.toLocaleString('en-IN', { maximumFractionDigits: 2 })}
          </td>
          <td class="py-2 px-2 text-right no-print">
            <button onclick="removeQuoteLineItem(${idx})" class="text-rose-400 hover:text-rose-300 text-xs">✕</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      const discount = Number(quote.discount || 0);
      const grandTotal = Math.max(0, subtotal + totalTax - discount);
      document.getElementById("quoteSubtotalDisplay").textContent = `₹${subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
      document.getElementById("quoteTaxDisplay").textContent = `₹${totalTax.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
      document.getElementById("quoteGrandTotalDisplay").textContent = `₹${grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    }

