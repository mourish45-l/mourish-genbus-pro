    let currentChatUnsub = null;
    function subscribeToChatThread(threadId) {
      activeBizChatThread = threadId;
      renderChatThreadsSidebar();

      if (threadId === "team_internal") {
        document.getElementById("activeChatHeaderTitle").textContent = "Internal Team Collaboration Room";
      } else {
        const custId = threadId.replace("cust_", "");
        const cust = allCustomers[custId];
        document.getElementById("activeChatHeaderTitle").textContent = cust ? `Customer Chat: ${cust.name} (${cust.phone})` : "Customer Chat";
      }

      const msgRef = ref(db, `chats/${threadId}/messages`);
      onValue(msgRef, (snap) => {
        const msgs = snap.exists() ? Object.entries(snap.val()) : [];
        renderMessagesIntoBox(msgs, "bizChatMessagesBox", "BUSINESS", threadId);
        if (matchedCustomerRecord && threadId === "cust_" + matchedCustomerRecord.id) {
          renderMessagesIntoBox(msgs, "custChatMessagesBox", "CUSTOMER", threadId);
        }
      });
    }

    function renderMessagesIntoBox(entries, containerId, viewerRole, threadId) {
      const box = document.getElementById(containerId);
      if (!box) return;
      box.innerHTML = "";

      entries.forEach(([msgId, m]) => {
        // Mark message as seen by opposite party if not yet viewed
        if (viewerRole === "CUSTOMER" && m.senderRole === "BUSINESS" && !m.seenByReceiver) {
          update(ref(db, `chats/${threadId}/messages/${msgId}`), { seenByReceiver: true });
        }
        if (viewerRole === "BUSINESS" && m.senderRole === "CUSTOMER" && !m.seenByReceiver) {
          update(ref(db, `chats/${threadId}/messages/${msgId}`), { seenByReceiver: true });
        }

        const isMine = (viewerRole === "BUSINESS" && m.senderRole === "BUSINESS") ||
                       (viewerRole === "CUSTOMER" && m.senderRole === "CUSTOMER");

        const wrap = document.createElement("div");
        wrap.className = `flex flex-col ${isMine ? "items-end" : "items-start"}`;

        let editBadge = "";
        if (m.edited) {
          editBadge = m.editedBeforeSeen
            ? `<span class="text-[10px] text-emerald-300 ml-1">(edited before viewing)</span>`
            : `<span class="text-[10px] text-amber-300 ml-1">(edited)</span>`;
        }

        let fileAttachmentHtml = "";
        if (m.fileData) {
          if (m.fileType && m.fileType.startsWith("image/")) {
            fileAttachmentHtml = `<img src="${m.fileData}" class="mt-2 rounded-xl max-h-44 border border-slate-700" />`;
          } else {
            fileAttachmentHtml = `<a href="${m.fileData}" download="${m.fileName || 'file'}" class="mt-2 inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-900/90 text-indigo-300 text-xs border border-slate-700">📎 Download ${m.fileName || 'Attachment'}</a>`;
          }
        }

        wrap.innerHTML = `
          <div class="max-w-[80%] rounded-2xl px-4 py-2.5 text-xs ${
            isMine ? "bg-indigo-600 text-white" : "bg-slate-800 text-slate-100 border border-slate-700"
          }">
            <div class="flex items-center justify-between gap-3 text-[10px] opacity-80 mb-1">
              <span class="font-bold">${m.senderName}</span>
              <span>${m.timeString || ''} ${m.seenByReceiver ? '✓✓ Seen' : '✓ Sent'}</span>
            </div>
            <div class="text-sm leading-relaxed break-words">${m.text || ''} ${editBadge}</div>
            ${fileAttachmentHtml}
            ${isMine ? `
              <div class="mt-1.5 pt-1 border-t border-white/10 flex justify-end gap-2 text-[10px]">
                <button onclick="promptEditChatMessage('${threadId}', '${msgId}')" class="underline hover:text-amber-200">Edit Message</button>
                <button onclick="deleteChatMessage('${threadId}', '${msgId}')" class="underline hover:text-rose-300">Delete</button>
              </div>
            ` : ''}
          </div>
        `;
        box.appendChild(wrap);
      });
      box.scrollTop = box.scrollHeight;
    }

    window.sendChatMessage = async (senderRole, attachmentPayload = null) => {
      const isBiz = senderRole === "BUSINESS";
      const inputEl = document.getElementById(isBiz ? "bizChatTextInput" : "custChatTextInput");
      const text = inputEl ? inputEl.value.trim() : "";
      if (!text && !attachmentPayload) return;

      const threadId = isBiz ? activeBizChatThread : ("cust_" + (matchedCustomerRecord?.id || "cust_demo1"));
      const senderName = isBiz ? currentEditorName : (matchedCustomerRecord?.name || "Customer");

      const newMsgRef = push(ref(db, `chats/${threadId}/messages`));
      await set(newMsgRef, {
        senderId: currentUser?.uid || "customer_portal",
        senderName,
        senderRole,
        text,
        fileName: attachmentPayload?.fileName || null,
        fileType: attachmentPayload?.fileType || null,
        fileData: attachmentPayload?.fileData || null,
        seenByReceiver: false,
        edited: false,
        editedBeforeSeen: false,
        timestamp: Date.now(),
        timeString: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      });
      if (inputEl) inputEl.value = "";
    };

    // Edit Sent Message (Tracks whether receiver had viewed it yet!)
    window.promptEditChatMessage = async (threadId, msgId) => {
      const msgRef = ref(db, `chats/${threadId}/messages/${msgId}`);
      const snap = await get(msgRef);
      if (!snap.exists()) return;
      const msg = snap.val();
      const updatedText = window.prompt("Edit your message:", msg.text || "");
      if (updatedText === null || updatedText.trim() === "") return;

      await update(msgRef, {
        text: updatedText.trim(),
        edited: true,
        editedBeforeSeen: !msg.seenByReceiver
      });
      showToast(!msg.seenByReceiver ? "Message edited before recipient viewed it!" : "Message updated!");
    };

    window.deleteChatMessage = async (threadId, msgId) => {
      await remove(ref(db, `chats/${threadId}/messages/${msgId}`));
      showToast("Message deleted.");
    };

    // File Upload in Chat (Base64 Realtime Sync for instant Spark Plan compatibility)
    window.handleChatFileSelect = (input, role) => {
      const file = input.files?.[0];
      if (!file) return;
      if (file.size > 1.5 * 1024 * 1024) {
        return showToast("Please choose a file under 1.5 MB for Realtime DB sync.");
      }
      const reader = new FileReader();
      reader.onload = async (e) => {
        await sendChatMessage(role, {
          fileName: file.name,
          fileType: file.type,
          fileData: e.target.result
        });
        showToast("File uploaded to chat!");
      };
      reader.readAsDataURL(file);
    };

    // =========================================================
    // CUSTOMER PORTAL LOOKUP & FINALIZED QUOTATIONS VIEWER
    // =========================================================
    window.searchCustomerBusinesses = () => {
      const name = document.getElementById("custLookupName").value.trim().toLowerCase();
      const phone = document.getElementById("custLookupPhone").value.trim();
      const email = document.getElementById("custLookupEmail").value.trim().toLowerCase();

      if (!phone && !email && !name) {
        return showToast("Please enter your Phone Number, Email, or Name to search.");
      }

      const found = Object.values(allCustomers).find(c =>
        (phone && c.phone && c.phone.includes(phone)) ||
        (email && c.email && c.email.toLowerCase() === email) ||
        (name && c.name && c.name.toLowerCase().includes(name))
      );

      if (!found) {
        return showToast("No matching customer record found. Try phone: 9659233313");
      }

      matchedCustomerRecord = found;
      document.getElementById("customerMatchedWorkspace").classList.remove("hidden");
      document.getElementById("custPortalBizTitle").textContent = businessProfile.name;
      document.getElementById("custPortalBizSub").textContent = `${businessProfile.address} • GSTIN: ${businessProfile.gstin} • 📞 ${businessProfile.phone}`;

      document.getElementById("custSelfEditName").value = found.name || "";
      document.getElementById("custSelfEditPhone").value = found.phone || "";

      renderCustomerPortalQuotations();
      subscribeToChatThread("cust_" + found.id);
      showToast(`Connected to ${businessProfile.name}!`);
    };

    window.updateCustomerSelfDetails = async () => {
      if (!matchedCustomerRecord) return;
      const newName = document.getElementById("custSelfEditName").value.trim();
      const newPhone = document.getElementById("custSelfEditPhone").value.trim();
      await update(ref(db, `customers/${matchedCustomerRecord.id}`), {
        name: newName,
        phone: newPhone
      });
      matchedCustomerRecord.name = newName;
      matchedCustomerRecord.phone = newPhone;
      showToast("Your customer profile has been updated!");
    };

    function renderCustomerPortalQuotations() {
      const container = document.getElementById("customerFinalQuotationsList");
      if (!container || !matchedCustomerRecord) return;
      container.innerHTML = "";

      const finalizedQuotes = Object.values(allQuotations).filter(
        q => q.customerId === matchedCustomerRecord.id && q.status === "FINALIZED"
      );

      if (finalizedQuotes.length === 0) {
        container.innerHTML = `
          <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 text-center text-xs text-slate-400">
            No finalized quotations yet. You can message ${businessProfile.name} in the chat panel to request updates!
          </div>
        `;
        return;
      }

      finalizedQuotes.forEach(q => {
        let sub = 0, tax = 0;
        const rowsHtml = (q.items || []).map(item => {
          const raw = Number(item.qty || 0) * Number(item.rate || 0);
          const gstAmt = raw * (Number(item.gst || 0) / 100);
          sub += raw;
          tax += gstAmt;
          return `
            <tr class="border-b border-slate-800/60 text-xs">
              <td class="py-2">${item.name}</td>
              <td class="py-2 text-center">${item.qty}</td>
              <td class="py-2 text-right">₹${Number(item.rate).toLocaleString('en-IN')}</td>
              <td class="py-2 text-right font-semibold">₹${(raw + gstAmt).toLocaleString('en-IN')}</td>
            </tr>
          `;
        }).join("");

        const grand = Math.max(0, sub + tax - Number(q.discount || 0));

        const card = document.createElement("div");
        card.className = "glass m3-card p-5 border border-slate-800 space-y-4";
        card.innerHTML = `
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
              <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300">FINALIZED QUOTATION</span>
              <h4 class="font-extrabold text-base mt-1">${q.quoteNumber} — ${q.title}</h4>
              <p class="text-xs text-slate-400">Valid Until: ${q.validUntil || 'N/A'}</p>
            </div>
            <div class="text-right">
              <div class="text-xs text-slate-400">Grand Total</div>
              <div class="text-xl font-extrabold text-emerald-400">₹${grand.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
            </div>
          </div>

          <table class="w-full text-left">
            <thead>
              <tr class="text-[10px] uppercase text-slate-400 border-b border-slate-800">
                <th class="pb-1.5">Description</th>
                <th class="pb-1.5 text-center">Qty</th>
                <th class="pb-1.5 text-right">Rate</th>
                <th class="pb-1.5 text-right">Total (incl. GST)</th>
              </tr>
            </thead>
            <tbody>${rowsHtml}</tbody>
          </table>

          <div class="text-xs text-slate-400 bg-slate-900/80 p-3 rounded-xl border border-slate-800">
            <strong>Terms & Notes:</strong> ${q.notes || 'Standard terms apply.'}
          </div>
        `;
        container.appendChild(card);
      });
    }
  </script>
</body>
</html>
