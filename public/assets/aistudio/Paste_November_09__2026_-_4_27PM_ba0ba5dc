<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mourish GenBus — Realtime Collaborative CRM, Catalogue & Quotation Suite</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts & Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0" />
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },
          colors: {
            m3: {
              bg: '#0B0F17',
              surface: '#131B2E',
              card: '#1C263B',
              primary: '#6366F1',
              accent: '#10B981',
              warn: '#F59E0B',
              danger: '#EF4444'
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0B0F17;
      color: #F8FAFC;
      overflow-x: hidden;
    }
    .glass {
      background: rgba(28, 38, 59, 0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .m3-pill {
      border-radius: 9999px;
    }
    .m3-card {
      border-radius: 24px;
    }
    /* Print Styles for Finalized Quotation */
    @media print {
      body * { visibility: hidden; }
      #printableQuotation, #printableQuotation * { visibility: visible; }
      #printableQuotation {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        color: black !important;
        padding: 24px !important;
        box-shadow: none !important;
      }
      .no-print { display: none !important; }
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0B0F17; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

  <!-- TOP GLOBAL HEADER -->
  <header class="glass sticky top-0 z-40 px-4 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3 border-b border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-indigo-600 to-emerald-400 flex items-center justify-center shadow-lg shadow-indigo-500/20">
        <span class="material-symbols-rounded text-white">hub</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">Mourish GenBus</h1>
          <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Asia-SE1 Live</span>
        </div>
        <p class="text-xs text-slate-400">Realtime Quotation, Catalogue & Multi-Customer Chat Suite</p>
      </div>
    </div>

    <!-- Portal Switcher & Active Editors Pill -->
    <div class="flex items-center gap-3">
      <div id="livePresenceBar" class="hidden md:flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/70 px-3 py-1.5 rounded-full text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-slate-400">Live Now:</span>
        <div id="presenceAvatars" class="flex items-center gap-1 font-semibold text-indigo-300"></div>
      </div>

      <!-- Mode Switch: Business vs Customer Portal -->
      <div class="bg-slate-900 p-1 rounded-full border border-slate-800 flex items-center text-xs font-semibold">
        <button id="switchBusinessBtn" onclick="switchPortalMode('business')" class="px-4 py-1.5 rounded-full bg-indigo-600 text-white transition flex items-center gap-1">
          <span class="material-symbols-rounded text-sm">business_center</span> Business Portal
        </button>
        <button id="switchCustomerBtn" onclick="switchPortalMode('customer')" class="px-4 py-1.5 rounded-full text-slate-400 hover:text-white transition flex items-center gap-1">
          <span class="material-symbols-rounded text-sm">person_search</span> Customer Portal
        </button>
      </div>

      <!-- Auth User Badge -->
      <div id="userStatusArea" class="hidden items-center gap-2 bg-slate-800/80 pl-3 pr-2 py-1 rounded-full border border-slate-700">
        <span id="userDisplayName" class="text-xs font-medium text-slate-200 truncate max-w-[140px]">User</span>
        <button onclick="openMfaModal()" title="SMS MFA & Security Settings" class="p-1 text-amber-400 hover:bg-slate-700 rounded-full">
          <span class="material-symbols-rounded text-sm">shield_lock</span>
        </button>
        <button onclick="handleSignOut()" title="Sign Out" class="p-1 text-rose-400 hover:bg-slate-700 rounded-full">
          <span class="material-symbols-rounded text-sm">logout</span>
        </button>
      </div>
    </div>
  </header>

  <!-- TOAST NOTIFICATION -->
  <div id="toastBox" class="fixed bottom-5 right-5 z-50 hidden max-w-sm glass px-4 py-3 rounded-2xl border border-indigo-500/40 shadow-2xl flex items-center gap-3 text-sm">
    <span class="material-symbols-rounded text-indigo-400">notifications_active</span>
    <span id="toastMsg">Notification</span>
  </div>

  <!-- ========================================================= -->
  <!-- 1. AUTHENTICATION SCREEN (FOR BUSINESS PORTAL)            -->
  <!-- ========================================================= -->
  <section id="authView" class="flex-1 flex items-center justify-center p-4">
    <div class="glass m3-card max-w-md w-full p-6 lg:p-8 shadow-2xl border border-slate-800/80 space-y-6">
      <div class="text-center space-y-2">
        <div class="w-14 h-14 rounded-3xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center mx-auto text-indigo-400">
          <span class="material-symbols-rounded text-3xl">lock_open_right</span>
        </div>
        <h2 class="text-2xl font-extrabold">Sign in to Business Workspace</h2>
        <p class="text-xs text-slate-400">Collaborate in real-time on quotations, catalogues & team chat. Customers can switch directly to the Customer Portal above.</p>
      </div>

      <!-- Continue with Google -->
      <button onclick="loginWithGoogle()" class="w-full py-3 px-4 m3-pill bg-white text-slate-900 font-bold text-sm flex items-center justify-center gap-3 hover:bg-slate-100 transition shadow">
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.8C6.2 7.2 8.9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.6l3.7 2.9c2.2-2 3.7-5 3.7-8.7z"/><path fill="#FBBC05" d="M5.3 14.8c-.2-.8-.4-1.6-.4-2.5s.2-1.7.4-2.5L1.6 7C.6 9 0 11.2 0 13.5s.6 4.5 1.6 6.5l3.7-2.9z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5l-3.7 2.8C3.5 20.9 7.4 24 12 24z"/></svg>
        Continue with Google
      </button>

      <div class="relative flex py-1 items-center">
        <div class="flex-grow border-t border-slate-800"></div>
        <span class="flex-shrink mx-3 text-xs text-slate-500 uppercase font-semibold">Or Email Login</span>
        <div class="flex-grow border-t border-slate-800"></div>
      </div>

      <!-- Auth Tabs: Password vs Passwordless Link -->
      <div class="grid grid-cols-2 gap-1 bg-slate-900 p-1 rounded-xl text-xs font-semibold">
        <button id="tabEmailPass" onclick="toggleAuthTab('password')" class="py-2 rounded-lg bg-slate-800 text-white">Email & Password</button>
        <button id="tabEmailLink" onclick="toggleAuthTab('link')" class="py-2 rounded-lg text-slate-400">Passwordless Link</button>
      </div>

      <!-- Email + Password Form -->
      <div id="formEmailPass" class="space-y-3">
        <input id="authNameInput" type="text" placeholder="Your Full Name / Editor Alias (for new signup)" class="w-full px-4 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-sm focus:border-indigo-500 focus:outline-none" />
        <input id="authEmailInput" type="email" placeholder="Work Email Address" class="w-full px-4 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-sm focus:border-indigo-500 focus:outline-none" />
        <input id="authPassInput" type="password" placeholder="Password (min 6 chars)" class="w-full px-4 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-sm focus:border-indigo-500 focus:outline-none" />
        <div class="grid grid-cols-2 gap-2 pt-1">
          <button onclick="loginWithEmailPassword()" class="py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition">Sign In</button>
          <button onclick="registerWithEmailPassword()" class="py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm transition border border-slate-700">Create Account</button>
        </div>
      </div>

      <!-- Passwordless Email Link Form -->
      <div id="formEmailLink" class="hidden space-y-3">
        <p class="text-xs text-slate-400">We'll send an instant magic sign-in link to your inbox—no password needed (Included in Spark Plan).</p>
        <input id="magicEmailInput" type="email" placeholder="Enter your email address" class="w-full px-4 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-sm focus:border-indigo-500 focus:outline-none" />
        <button onclick="sendPasswordlessEmailLink()" class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition">Send Magic Login Link</button>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 2. BUSINESS PORTAL VIEW                                   -->
  <!-- ========================================================= -->
  <main id="businessPortalView" class="hidden flex-1 flex flex-col lg:flex-row gap-4 p-4 lg:p-6 max-w-[1600px] w-full mx-auto">
    
    <!-- LEFT NAVIGATION RAIL -->
    <aside class="lg:w-64 glass m3-card p-4 flex flex-col justify-between gap-4 shrink-0">
      <div class="space-y-4">
        <div class="p-3 rounded-2xl bg-indigo-600/10 border border-indigo-500/20">
          <div class="text-[11px] uppercase font-bold text-indigo-400">Active Business ID</div>
          <div id="activeBizBadge" class="font-bold text-sm truncate mt-0.5">Mourish Developers</div>
          <div id="activeBizGstin" class="text-[11px] text-slate-400">GSTIN: 33CQLPT6813M1Z7</div>
        </div>

        <nav class="space-y-1 text-sm font-medium">
          <button onclick="switchBizTab('quoteEditor')" id="nav_quoteEditor" class="biz-nav w-full flex items-center gap-3 px-4 py-3 rounded-2xl bg-indigo-600 text-white">
            <span class="material-symbols-rounded">request_quote</span> Quotations & Live Edit
          </button>
          <button onclick="switchBizTab('catalogue')" id="nav_catalogue" class="biz-nav w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:bg-slate-800/60">
            <span class="material-symbols-rounded">inventory_2</span> Product Catalogue
          </button>
          <button onclick="switchBizTab('customers')" id="nav_customers" class="biz-nav w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:bg-slate-800/60">
            <span class="material-symbols-rounded">groups</span> Customers CRM
          </button>
          <button onclick="switchBizTab('teamChat')" id="nav_teamChat" class="biz-nav w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:bg-slate-800/60">
            <span class="material-symbols-rounded">forum</span> Multi-Chat & Files
          </button>
          <button onclick="switchBizTab('bizProfile')" id="nav_bizProfile" class="biz-nav w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-300 hover:bg-slate-800/60">
            <span class="material-symbols-rounded">domain</span> Edit Business Profile
          </button>
        </nav>
      </div>

      <!-- Realtime Editor Activity Feed -->
      <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 space-y-2">
        <div class="flex items-center justify-between text-xs font-bold text-slate-400">
          <span>LIVE AUDIT STAMP</span>
          <span class="material-symbols-rounded text-sm text-emerald-400">bolt</span>
        </div>
        <div id="liveAuditBox" class="text-xs text-slate-300 space-y-1">
          <div>Waiting for live edits...</div>
        </div>
      </div>
    </aside>

    <!-- CENTER MAIN WORKSPACE -->
    <div class="flex-1 flex flex-col gap-4 min-w-0">

      <!-- TAB A: QUOTATIONS & COLLABORATIVE LIVE EDITOR -->
      <div id="bizTab_quoteEditor" class="biz-panel grid grid-cols-1 xl:grid-cols-12 gap-4">
        
        <!-- Left Column: Saved Drafts & Finalized Quotations List -->
        <div class="xl:col-span-4 glass m3-card p-5 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="font-bold text-base">All Quotations</h3>
              <p class="text-xs text-slate-400">Drafts & Finalized (Synced Live)</p>
            </div>
            <button onclick="createNewQuotation()" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold flex items-center gap-1">
              <span class="material-symbols-rounded text-sm">add</span> New Quote
            </button>
          </div>

          <input id="searchQuotesInput" oninput="renderQuotationsList()" type="text" placeholder="Search quote #, customer, status..." class="w-full px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs" />

          <div id="quotationsListContainer" class="space-y-2.5 max-h-[600px] overflow-y-auto pr-1"></div>
        </div>

        <!-- Right Column: Realtime Collaborative Quotation Builder -->
        <div class="xl:col-span-8 glass m3-card p-5 lg:p-6 space-y-5" id="printableQuotation">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
            <div>
              <div class="flex items-center gap-2">
                <span id="quoteStatusPill" class="px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">DRAFT</span>
                <input id="quoteNumberInput" oninput="syncCurrentQuoteField('quoteNumber', this.value)" type="text" class="bg-transparent font-extrabold text-lg border-b border-transparent focus:border-indigo-500 focus:outline-none w-44" value="QT-2026-001" />
              </div>
              <p id="lastEditedByBanner" class="text-xs text-emerald-400 mt-1">Realtime collaboration active — edits sync immediately</p>
            </div>

            <div class="flex flex-wrap items-center gap-2 no-print">
              <button onclick="setQuoteStatus('DRAFT')" class="px-3 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold">Save as Draft</button>
              <button onclick="setQuoteStatus('FINALIZED')" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center gap-1 shadow-lg shadow-emerald-600/20">
                <span class="material-symbols-rounded text-sm">verified</span> Finalize for Customer
              </button>
              <button onclick="window.print()" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs" title="Print / Export PDF">
                <span class="material-symbols-rounded text-sm">print</span>
              </button>
              <button onclick="deleteCurrentQuotation()" class="p-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-xs" title="Delete Quote">
                <span class="material-symbols-rounded text-sm">delete</span>
              </button>
            </div>
          </div>

          <!-- Select Customer & Validity -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
              <label class="text-xs text-slate-400 font-semibold">Assign Customer</label>
              <select id="quoteCustomerSelect" onchange="onQuoteCustomerChange(this.value)" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm"></select>
            </div>
            <div>
              <label class="text-xs text-slate-400 font-semibold">Project / Subject Title</label>
              <input id="quoteTitleInput" oninput="syncCurrentQuoteField('title', this.value)" type="text" placeholder="e.g. Medical Gas Pipeline & Web Portal" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm" />
            </div>
            <div>
              <label class="text-xs text-slate-400 font-semibold">Valid Until</label>
              <input id="quoteDateInput" oninput="syncCurrentQuoteField('validUntil', this.value)" type="date" class="w-full mt-1 px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm" />
            </div>
          </div>

          <!-- Quick Add from Catalogue Bar -->
          <div class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800 flex flex-wrap items-center justify-between gap-2 no-print">
            <div class="flex items-center gap-2 text-xs font-semibold text-indigo-300">
              <span class="material-symbols-rounded text-base">Auto_Awesome</span> Quick Insert from Catalogue:
            </div>
            <div class="flex flex-1 items-center gap-2 min-w-[240px]">
              <select id="quickCatalogueSelect" class="flex-1 px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-xs"></select>
              <button onclick="insertItemFromCatalogue()" class="px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold">+ Add Item</button>
              <button onclick="addBlankLineItem()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700">+ Custom Row</button>
            </div>
          </div>

          <!-- Line Items Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-slate-800 text-[11px] uppercase text-slate-400">
                  <th class="py-2.5 px-2">Item / Description</th>
                  <th class="py-2.5 px-2 w-24">Qty</th>
                  <th class="py-2.5 px-2 w-32">Unit Rate (₹)</th>
                  <th class="py-2.5 px-2 w-24">GST %</th>
                  <th class="py-2.5 px-2 w-32 text-right">Line Total (₹)</th>
                  <th class="py-2.5 px-2 w-10 no-print"></th>
                </tr>
              </thead>
              <tbody id="quoteItemsTableBody" class="divide-y divide-slate-800/60 text-sm"></tbody>
            </table>
          </div>

          <!-- Totals & Terms -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-3 border-t border-slate-800">
            <div>
              <label class="text-xs text-slate-400 font-semibold">Notes & Payment Terms (Editable Live)</label>
              <textarea id="quoteNotesInput" oninput="syncCurrentQuoteField('notes', this.value)" rows="3" class="w-full mt-1 p-3 rounded-xl bg-slate-900 border border-slate-700 text-xs" placeholder="50% advance with PO, balance upon commissioning..."></textarea>
            </div>
            <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800 space-y-2 text-sm">
              <div class="flex justify-between text-slate-400">
                <span>Subtotal:</span>
                <span id="quoteSubtotalDisplay">₹0.00</span>
              </div>
              <div class="flex justify-between text-slate-400">
                <span>Total GST Tax:</span>
                <span id="quoteTaxDisplay">₹0.00</span>
              </div>
              <div class="flex justify-between items-center text-slate-400">
                <span>Discount (₹):</span>
                <input id="quoteDiscountInput" oninput="syncCurrentQuoteField('discount', Number(this.value||0))" type="number" class="w-28 px-2 py-1 rounded bg-slate-800 border border-slate-700 text-right text-xs text-white" value="0" />
              </div>
              <div class="flex justify-between font-extrabold text-lg text-emerald-400 pt-2 border-t border-slate-800">
                <span>Grand Total:</span>
                <span id="quoteGrandTotalDisplay">₹0.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB B: PRODUCT CATALOGUE MANAGER (FULL CRUD) -->
      <div id="bizTab_catalogue" class="biz-panel hidden glass m3-card p-6 space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="text-lg font-bold">Interactive Product & Service Catalogue</h3>
            <p class="text-xs text-slate-400">Add, edit, or delete catalogue items. Changes sync across all team members immediately.</p>
          </div>
        </div>

        <!-- Add / Update Catalogue Form -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-3 bg-slate-900/90 p-4 rounded-2xl border border-slate-800">
          <input id="catItemId" type="hidden" />
          <input id="catNameInput" type="text" placeholder="Product / Service Name" class="md:col-span-2 px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
          <input id="catCategoryInput" type="text" placeholder="Category (e.g. Medical Gas / Web)" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
          <input id="catRateInput" type="number" placeholder="Unit Price (₹)" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
          <div class="flex gap-2">
            <input id="catGstInput" type="number" placeholder="GST %" value="18" class="w-20 px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
            <button onclick="saveCatalogueItem()" class="flex-1 py-2 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs">Save Item</button>
          </div>
        </div>

        <div id="catalogueGridContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>

      <!-- TAB C: CUSTOMERS CRM (MULTI-CUSTOMER + EDIT) -->
      <div id="bizTab_customers" class="biz-panel hidden glass m3-card p-6 space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-bold">Customer Directory & Lookup Access</h3>
            <p class="text-xs text-slate-400">Customers added here can enter their Phone or Email in the Customer Portal to view finalized quotes and chat with your team.</p>
          </div>
        </div>

        <!-- Add / Edit Customer Form -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-3 bg-slate-900/90 p-4 rounded-2xl border border-slate-800">
          <input id="custIdHidden" type="hidden" />
          <input id="custNameInput" type="text" placeholder="Customer / Hospital Name" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
          <input id="custPhoneInput" type="text" placeholder="Phone (e.g. 9659233313)" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
          <input id="custEmailInput" type="email" placeholder="Customer Email" class="px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-sm" />
