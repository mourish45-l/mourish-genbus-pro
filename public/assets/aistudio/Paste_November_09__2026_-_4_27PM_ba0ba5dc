    window.enrollSmsMfa = async () => {
      if (!currentUser) return showToast("Sign in first to configure SMS MFA.");
      const phone = document.getElementById("mfaPhoneInput").value.trim();
      if (!phone) return showToast("Enter phone number in +91 format.");
      try {
        if (!window.recaptchaVerifier) {
          window.recaptchaVerifier = new RecaptchaVerifier(auth, "recaptcha-mfa-container", { size: "invisible" });
